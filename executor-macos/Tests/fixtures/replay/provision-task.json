{
  "format": "task/v1",
  "id": "tsk_provision1",
  "version": 1,
  "name": "Provision a staff account (stand-in)",
  "author": "officer",
  "created": "2026-11-24T10:00:00+08:00",
  "platform": "macos",
  "apps": [{ "key": "chrome", "bundle": "com.google.Chrome" }],
  "inputs": [
    { "name": "full_name", "type": "text", "source": "ask" },
    { "name": "email", "type": "email", "source": "ask" },
    { "name": "school", "type": "text", "source": "ask" },
    { "name": "role", "type": "text", "source": "ask" }
  ],
  "steps": [
    {
      "id": "s1", "say": "Type into Full name", "app": "chrome", "action": "set_value",
      "target": { "role": "AXTextField", "label": "Full name", "dom_id": "full-name" },
      "value": { "input": "full_name" },
      "expect": [{ "kind": "value_equals", "input": "full_name" }],
      "consequential": "no"
    },
    {
      "id": "s2", "say": "Type into Email", "app": "chrome", "action": "set_value",
      "target": { "role": "AXTextField", "label": "Email", "dom_id": "email" },
      "value": { "input": "email" },
      "expect": [{ "kind": "value_equals", "input": "email" }],
      "consequential": "no"
    },
    {
      "id": "s3", "say": "Choose School", "app": "chrome", "action": "select",
      "target": { "role": "AXPopUpButton", "label": "School", "dom_id": "school" },
      "value": { "input": "school" },
      "expect": [{ "kind": "value_equals", "input": "school" }],
      "consequential": "no"
    },
    {
      "id": "s4", "say": "Choose Role", "app": "chrome", "action": "select",
      "target": { "role": "AXPopUpButton", "label": "Role", "dom_id": "role" },
      "value": { "input": "role" },
      "expect": [{ "kind": "value_equals", "input": "role" }],
      "consequential": "no"
    },
    {
      "id": "s5", "say": "Press Create account", "app": "chrome", "action": "press",
      "target": { "role": "AXButton", "label": "Create account", "dom_id": "create", "anchors": ["Role"] },
      "expect": [{ "kind": "appears", "target": { "role": "AXHeading", "label": "Account created" } }],
      "consequential": "yes",
      "approval": { "summary": "Create a staff account for {full_name} ({email}), {role} at {school}", "undoable": false }
    }
  ]
}
